# What Cloud Build uploads for deploy_cloud.sh: only what the Dockerfile uses.
/*
!/Dockerfile
!/docker-entrypoint.sh
!/requirements.txt
!/.dockerignore
!/hermes-mission/
!/pipeline/
!/config/
!/registry/
!/knowledge/
!/core/

# Never uploaded: secrets, builds, caches, runtime data (the bucket has it).
**/.env
**/.env.*
pipeline/keys/
**/node_modules/
**/.next/
**/__pycache__/
**/*.pyc
*.mp4
*.zip
*.tar.gz
pipeline/logs/
pipeline/state/gtm_runs/
pipeline/state/runs_archive/
pipeline/state/research_runs/
pipeline/state/device_showcase/
pipeline/state/reference_analysis/
pipeline/state/hard_reset_renders/
pipeline/state/test_renders/
pipeline/state/veo_videos/
pipeline/state/direct_posters/
pipeline/state/visuals/
pipeline/state/*.png
pipeline/state/research_latest.json
pipeline/state/research_seen.json
# ...except the brand's own logos, which the poster agents read from here
# (without logo.png the approved-style poster fails and falls back to a template).
!pipeline/state/logo.png
!pipeline/state/vanna_official_master_logo.png
!pipeline/state/vanna_full_brand_badge.png
pipeline/state/*.html
pipeline/brain/tenants/*/brain.db*
pipeline/brain/tenants/*/website/
pipeline/gtm_engine/registry/cache/
pipeline/gtm_engine/registry/snapshots/

# This machine's live process state: never valid inside another container.
# (The rest of pipeline/state is overwritten from the bucket at start;
# see state_sync.pull_state, which lets the bucket win in the cloud.)
pipeline/state/*.pid
pipeline/state/*.lock
pipeline/state/_tell.lock
pipeline/state/_tick_live.json
pipeline/state/daemon_status.json
pipeline/state/daemon_wanted.json
pipeline/state/telegram_pending_*.json
pipeline/state/scheduler_state.json
pipeline/state/x_seen.json
pipeline/state/x_context_cursor.json
pipeline/state/telegram_sent_news.json
